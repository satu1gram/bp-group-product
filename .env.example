# Salin file ini menjadi .env dan isi dengan nilai asli dari Supabase dashboard
# Project Settings → API → Project URL & anon/public key

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Advisor berjalan lewat Supabase Edge Function `ai-konsultasi`.
# Kunci API AI disimpan sebagai secret di Supabase, JANGAN taruh di sini (VITE_* terlihat publik).

# Google Analytics 4 (opsional) — Measurement ID dari GA4, contoh: G-XXXXXXXXXX
# Di Cloudflare: Settings → Variables and Secrets, lalu deploy ulang
VITE_GA4_ID=

# Alamat website (dipakai untuk sitemap & data terstruktur saat build)
SITE_URL=https://katalog.mitrabp.biz.id
